{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run db:generate --workspace=server"
  },
  "deploy": {
    "preDeployCommand": ["npm exec --workspace=server -- prisma db push --skip-generate", "npm run db:seed --workspace=server"],
    "startCommand": "npm start --workspace=server",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
