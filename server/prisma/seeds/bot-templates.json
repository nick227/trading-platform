    "botType": "rule_based",
    "tags": [
      "risk",
      "long",
      "stop-loss",
      "exit"
    ],
    "config": {
      "direction": "buy",
      "tickers": [
        "SPY"
      ],
      "capitalMode": "allocated",
      "allocatedAmount": 10000,
      "maxOrderNotional": 2000,
      "exit": {
        "rules": [
          {
            "type": "stop_loss",
            "config": {
              "pct": 10
            }
          }
        ]
      }
    },
    "rules": [
      {
        "name": "Market Hours",
        "type": "market_hours",
        "config": {
          "allowPremarket": false,
          "allowAfterHours": false
        }
      },
      {
        "name": "Monthly",
        "type": "cooldown",
        "config": {
          "cooldownHours": 720
        }
      }
    ]
  },
  {
    "id": "tmpl_spy_trend_filter",
    "name": "SPY Trend Filter",
    "description": "Holds while SPY is above its 200-day average and sells its own shares when SPY's trend turns down. Evaluated at the daily close.",
    "botType": "rule_based",
    "tags": [
      "spy",
      "trend",
      "regime",
      "exit"
    ],
    "config": {
      "direction": "buy",
      "tickers": [
        "SPY"
      ],
      "capitalMode": "allocated",
      "allocatedAmount": 10000,
      "maxOrderNotional": 2000,
      "exit": {
        "rules": [
          {
            "type": "trend_filter",
            "config": {
              "symbol": "SPY",
              "confirmationBars": 2,
              "requiredRegime": "risk_off"
            }
          }
        ]
      }
    },
    "rules": [
      {
        "name": "SPY uptrend",
        "type": "trend_filter",
        "config": {
          "symbol": "SPY",
          "confirmationBars": 2,
          "requiredRegime": "risk_on"
        }
      },
      {
        "name": "One order per day",
        "type": "cooldown",
        "config": {
          "cooldownHours": 24
        }
      }
    ]
  },
  {
    "id": "tmpl_alpha_research",
    "name": "Alpha Research Follower",
    "description": "Trades only on current, verified Alpha Engine predictions, archiving the evidence with each order. Stale, low-confidence or price-drifted research is not traded. Paper only.",
    "botType": "rule_based",
    "tags": [
      "research",
      "alpha-engine",
      "evidence"
    ],
    "config": {
      "signalSource": "alpha_research",
      "tickers": [
        "SPY"
      ],
      "capitalMode": "allocated",
      "allocatedAmount": 5000,
      "maxOrderNotional": 1000,
      "research": {
        "minConfidence": 0.6,
        "maxPredictionAgeHours": 96,
        "maxEntryDriftPct": 5
      }
    },
    "rules": [
      {
        "name": "Market Hours",
        "type": "market_hours",
        "config": {
          "allowPremarket": false,
          "allowAfterHours": false
        }
      },
      {
        "name": "Position Limit",
        "type": "position_limit",
        "config": {
          "maxShares": 100,
          "maxQuantity": 100
        }
      }
    ]
  }
