[
  {
    "id": "tmpl_momentum_buy",
    "name": "Momentum Buy",
    "description": "Buys a ticker when price rises above a configurable threshold. Enforces market hours, position limits, and a per-ticker cooldown to prevent overtrading.",
    "botType": "rule_based",
    "tags": [
      "momentum",
      "long",
      "threshold"
    ],
    "config": {
      "direction": "buy",
      "quantity": 1,
      "tickers": [
        "SPY"
      ],
      "capitalMode": "allocated",
      "allocatedAmount": 5000,
      "maxOrderNotional": 1000
    },
    "rules": [
      {
        "name": "Market Hours",
        "type": "market_hours",
        "config": {
          "allowPremarket": false,
          "allowAfterHours": false
        }
      },
      {
        "name": "Price Above Threshold",
        "type": "price_threshold",
        "config": {
          "direction": "above",
          "operator": "above",
          "price": 0
        }
      },
      {
        "name": "Position Limit",
        "type": "position_limit",
        "config": {
          "maxShares": 100,
          "maxQuantity": 100
        }
      },
      {
        "name": "Cooldown",
        "type": "cooldown",
        "config": {
          "windowMs": 3600000
        }
      }
    ]
  },
  {
    "id": "tmpl_dca_accumulator",
    "name": "DCA Accumulator",
    "description": "Invests a fixed $1,000 every 30 days regardless of price, spreading the capital over about ten months instead of buying at once.",
    "botType": "rule_based",
    "tags": [
      "dca",
      "long",
      "accumulation",
      "schedule"
    ],
    "config": {
      "direction": "buy",
      "tickers": [
        "SPY"
      ],
      "capitalMode": "allocated",
      "allocatedAmount": 10000,
      "maxOrderNotional": 1000
    },
    "rules": [
      {
        "name": "Market Hours",
        "type": "market_hours",
        "config": {
          "allowPremarket": false,
          "allowAfterHours": false
        }
      },
      {
        "name": "Monthly",
        "type": "cooldown",
        "config": {
          "cooldownHours": 720
        }
      }
    ]
  },
  {
    "id": "tmpl_momentum_sell",
    "name": "Momentum Exit",
    "description": "Buys after a 5% rise over 20 sessions and sells its own shares when the rise reverses (a 5% fall over 10 sessions) or the price drops 8% below its cost. Never sells shares it doesn't hold.",
    "botType": "rule_based",
    "tags": [
      "momentum",
      "long",
      "exit"
    ],
    "config": {
      "direction": "buy",
      "tickers": [
        "SPY"
      ],
      "capitalMode": "allocated",
      "allocatedAmount": 10000,
      "maxOrderNotional": 2000,
      "exit": {
        "rules": [
          {
            "type": "price_change",
            "config": {
              "sessions": 10,
              "operator": "below",
              "pct": 5
            }
          },
          {
            "type": "stop_loss",
            "config": {
              "pct": 8
            }
          }
        ]
      }
    },
    "rules": [
      {
        "name": "Market Hours",
        "type": "market_hours",
        "config": {
          "allowPremarket": false,
          "allowAfterHours": false
        }
      },
      {
        "name": "Momentum",
        "type": "price_change",
        "config": {
          "sessions": 20,
          "operator": "above",
          "pct": 5
        }
      },
      {
        "name": "At most weekly",
        "type": "cooldown",
        "config": {
          "cooldownHours": 120
        }
      }
    ]
  },
  {
    "id": "tmpl_loss_guard",
